#!/bin/sh
#
# S62ckpool - BusyBox init service for ckpool
#

CONF=/root/config/ckpool.conf
LOGDIR=/root/config/ckpool/logs
LOGFILE=${LOGDIR}/ckpool.log
WAIT_PID_FILE=/var/run/ckpool-autostart.pid
BTC_CONF=/root/config/bitcoin.conf
BTC_DATADIR=/root/block
RESIZE_DONE_FLAG=/resize_done
BTC_READY_CHECK=/usr/bin/rockbase_bitcoind_ready.sh

is_running() {
    pidof ckpool >/dev/null 2>&1
}

resize_ready() {
    [ -f "${RESIZE_DONE_FLAG}" ]
}

bitcoind_ready() {
    BTC_CONF="${BTC_CONF}" BTC_DATADIR="${BTC_DATADIR}" "${BTC_READY_CHECK}" >/dev/null 2>&1
}

waiter_running() {
    [ -f "${WAIT_PID_FILE}" ] || return 1

    wait_pid=$(cat "${WAIT_PID_FILE}" 2>/dev/null)
    [ -n "${wait_pid}" ] || return 1
    kill -0 "${wait_pid}" 2>/dev/null
}

clear_waiter() {
    rm -f "${WAIT_PID_FILE}"
}

stop_waiter() {
    if waiter_running; then
        kill "$(cat "${WAIT_PID_FILE}" 2>/dev/null)" 2>/dev/null || true
    fi
    clear_waiter
}

start_waiter() {
    start-stop-daemon -S -b -m -q -p "${WAIT_PID_FILE}" -x /bin/sh -- -c '
        while :; do
            if pidof ckpool >/dev/null 2>&1; then
                rm -f "'"${WAIT_PID_FILE}"'"
                exit 0
            fi

            if BTC_CONF="'"${BTC_CONF}"'" BTC_DATADIR="'"${BTC_DATADIR}"'" "'"${BTC_READY_CHECK}"'" >/dev/null 2>&1; then
                mkdir -p "'"${LOGDIR}"'"
                # trim oversized log before redirect (board has no `stat`; use `wc -c`)
                _sz=$(wc -c < "'"${LOGFILE}"'" 2>/dev/null || echo 0)
                [ "$_sz" -gt 52428800 ] 2>/dev/null && : > "'"${LOGFILE}"'"
                # MALLOC_ARENA_MAX: cap glibc per-thread malloc arenas (default
                # 8*cores+8). The 27 ckpool threads otherwise grow ~9 x 64MB
                # arenas (RSS 233MB on 1G board), starving page cache.
                # NOTE: no apostrophes allowed in this comment (inside sh -c '...').
                MALLOC_ARENA_MAX=2 ckpool -B -c "'"${CONF}"'" > "'"${LOGFILE}"'" 2>&1 &
                sleep 2

                if pidof ckpool >/dev/null 2>&1; then
                    rm -f "'"${WAIT_PID_FILE}"'"
                    exit 0
                fi
            fi
            sleep 5
        done
    '
}

# Truncate ckpool.log if it exceeds the threshold (ckpool writes ~1 line/sec
# with no built-in rotation; unbounded growth fills the 975 MB config partition).
LOG_MAX_BYTES=52428800  # 50 MiB
trim_log() {
    if [ -f "${LOGFILE}" ]; then
        # board has no `stat`; use `wc -c` for byte size
        sz=$(wc -c < "${LOGFILE}" 2>/dev/null || echo 0)
        if [ "$sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null; then
            : > "${LOGFILE}"
        fi
    fi
}

start_ckpool() {
    mkdir -p "${LOGDIR}"
    trim_log
    # MALLOC_ARENA_MAX: cap glibc per-thread malloc arenas (see waiter above).
    MALLOC_ARENA_MAX=2 ckpool -B -c "${CONF}" > "${LOGFILE}" 2>&1 &
    sleep 2
    is_running
}

case "$1" in
  start)
        printf "Starting ckpool: "

        if is_running; then
                echo "already running"
                exit 0
        fi

        if ! resize_ready; then
                stop_waiter
                echo "deferred (waiting for resize_done)"
                exit 0
        fi

        if waiter_running; then
                echo "waiting for bitcoind sync"
                exit 0
        fi

        if bitcoind_ready; then
                if start_ckpool; then
                        echo "OK"
                else
                        echo "FAIL"
                        exit 1
                fi
                exit 0
        fi

        start_waiter
        echo "deferred (waiting for bitcoind sync)"
        ;;
  stop)
        printf "Stopping ckpool: "

        stop_waiter
        if ! is_running; then
                echo "already stopped"
                exit 0
        fi

        if /root/ckpool/stop.sh >/dev/null 2>&1; then
                echo "OK"
        else
                echo "FAIL"
                exit 1
        fi
        ;;
  restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
