#!/bin/sh
#
# S62ckpool - BusyBox init service for ckpool
#

CONF=/root/config/ckpool.conf
LOGDIR=/root/config/ckpool/logs
LOGFILE=${LOGDIR}/ckpool.log
WAIT_PID_FILE=/var/run/ckpool-autostart.pid
BTC_CONF=/root/config/bitcoin.conf
BTC_DATADIR=/root/block
RESIZE_DONE_FLAG=/resize_done
BTC_READY_CHECK=/usr/bin/rockbase_bitcoind_ready.sh

is_running() {
    pidof ckpool >/dev/null 2>&1
}

resize_ready() {
    [ -f "${RESIZE_DONE_FLAG}" ]
}

bitcoind_ready() {
    BTC_CONF="${BTC_CONF}" BTC_DATADIR="${BTC_DATADIR}" "${BTC_READY_CHECK}" >/dev/null 2>&1
}

waiter_running() {
    [ -f "${WAIT_PID_FILE}" ] || return 1

    wait_pid=$(cat "${WAIT_PID_FILE}" 2>/dev/null)
    [ -n "${wait_pid}" ] || return 1
    kill -0 "${wait_pid}" 2>/dev/null
}

clear_waiter() {
    rm -f "${WAIT_PID_FILE}"
}

stop_waiter() {
    if waiter_running; then
        kill "$(cat "${WAIT_PID_FILE}" 2>/dev/null)" 2>/dev/null || true
    fi
    clear_waiter
}

start_waiter() {
    start-stop-daemon -S -b -m -q -p "${WAIT_PID_FILE}" -x /bin/sh -- -c '
        _BTC_CONF="'"${BTC_CONF}"'"
        while :; do
            if pidof ckpool >/dev/null 2>&1; then
                rm -f "'"${WAIT_PID_FILE}"'"
                exit 0
            fi

            # Update boot progress with live block height BEFORE the ready
            # check, so even if bitcoind catches up on the very first
            # iteration the LCD still shows the height briefly.
            _info=$(bitcoin-cli -conf="${_BTC_CONF}" getblockchaininfo 2>/dev/null)
            _blocks=$(printf "%s" "${_info}" | sed -n "s/.*\"blocks\": *\([0-9][0-9]*\).*/\1/p" | head -1)
            _headers=$(printf "%s" "${_info}" | sed -n "s/.*\"headers\": *\([0-9][0-9]*\).*/\1/p" | head -1)
            if [ -n "${_blocks}" ] && [ -n "${_headers}" ]; then
                /usr/bin/rockbase_boot_progress.sh 4 6 90 "#f0b44c" "Stratum waiting: ${_blocks}/${_headers}" 2>/dev/null || true
            fi

            if BTC_CONF="${_BTC_CONF}" BTC_DATADIR="'"${BTC_DATADIR}"'" "'"${BTC_READY_CHECK}"'" >/dev/null 2>&1; then
                mkdir -p "'"${LOGDIR}"'"
                # trim oversized log before redirect (board has no `stat`; use `wc -c`)
                _sz=$(wc -c < "'"${LOGFILE}"'" 2>/dev/null || echo 0)
                [ "$_sz" -gt 52428800 ] 2>/dev/null && : > "'"${LOGFILE}"'"
                ckpool -c "'"${CONF}"'" > "'"${LOGFILE}"'" 2>&1 &
                sleep 2

                if pidof ckpool >/dev/null 2>&1; then
                    rm -f "'"${WAIT_PID_FILE}"'"
                    exit 0
                fi
            fi
            sleep 5
        done
    '
}

# Truncate ckpool.log if it exceeds the threshold (ckpool writes ~1 line/sec
# with no built-in rotation; unbounded growth fills the 975 MB config partition).
LOG_MAX_BYTES=52428800  # 50 MiB
trim_log() {
    if [ -f "${LOGFILE}" ]; then
        # board has no `stat`; use `wc -c` for byte size
        sz=$(wc -c < "${LOGFILE}" 2>/dev/null || echo 0)
        if [ "$sz" -gt "$LOG_MAX_BYTES" ] 2>/dev/null; then
            : > "${LOGFILE}"
        fi
    fi
}

start_ckpool() {
    mkdir -p "${LOGDIR}"
    trim_log
    ckpool -c "${CONF}" > "${LOGFILE}" 2>&1 &
    sleep 2
    is_running
}

case "$1" in
  start)
        printf "Starting ckpool: "
        /usr/bin/rockbase_boot_progress.sh 4 6 75 "#f0b44c" "Starting stratum..." 2>/dev/null || true

        if is_running; then
                echo "already running"
                exit 0
        fi

        if ! resize_ready; then
                stop_waiter
                echo "deferred (waiting for resize_done)"
                exit 0
        fi

        if waiter_running; then
                echo "waiting for bitcoind sync"
                exit 0
        fi

        if bitcoind_ready; then
                if start_ckpool; then
                        echo "OK"
                        # details: stratum listen port from ckpool.conf serverurl,
                        # shown as <board-ip>:<port> (miners connect to the board IP).
                        _STRATUM_PORT=$(grep -A2 '"serverurl"' "${CONF}" 2>/dev/null | grep -m1 '"[^"]*:[0-9][0-9]*"' | cut -d'"' -f2 | awk -F: 'NF{print $NF}')
                        [ -n "${_STRATUM_PORT}" ] || _STRATUM_PORT=3333
                        _BOARD_IP=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | head -1 | cut -d/ -f1)
                        /usr/bin/rockbase_boot_progress.sh 4 6 90 "#ffffff" "Stratum ready (${_BOARD_IP:-local}:${_STRATUM_PORT})" 2>/dev/null || true
                else
                        echo "FAIL"
                        exit 1
                fi
                exit 0
        fi

        start_waiter
        echo "deferred (waiting for bitcoind sync)"
        # Show current block height immediately so the LCD doesn't show a
        # static message before the waiter's first 5s tick.
        _info=$(bitcoin-cli -conf="${BTC_CONF}" getblockchaininfo 2>/dev/null)
        _blocks=$(printf "%s" "${_info}" | sed -n "s/.*\"blocks\": *\([0-9][0-9]*\).*/\1/p" | head -1)
        _headers=$(printf "%s" "${_info}" | sed -n "s/.*\"headers\": *\([0-9][0-9]*\).*/\1/p" | head -1)
        if [ -n "${_blocks}" ] && [ -n "${_headers}" ]; then
            /usr/bin/rockbase_boot_progress.sh 4 6 90 "#f0b44c" "Stratum waiting: ${_blocks}/${_headers}" 2>/dev/null || true
        else
            /usr/bin/rockbase_boot_progress.sh 4 6 90 "#f0b44c" "Stratum waiting (bitcoind sync)" 2>/dev/null || true
        fi
        ;;
  stop)
        printf "Stopping ckpool: "

        stop_waiter
        if ! is_running; then
                echo "already stopped"
                exit 0
        fi

        if /root/ckpool/stop.sh >/dev/null 2>&1; then
                echo "OK"
        else
                echo "FAIL"
                exit 1
        fi
        ;;
  restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
