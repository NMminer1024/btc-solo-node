#!/bin/sh
#
# S03lcdui - Rockbase onboard LCD UI
#

DAEMON=/usr/bin/rockbase-lcdui
PIDFILE=/var/run/rockbase-lcdui.pid
LOGFILE=/dev/null
if [ -r /etc/TZ ]; then
	TZ="$(sed 's/[[:space:]]//g' </etc/TZ 2>/dev/null)"
	case "${TZ}" in
		""|UTC|UTC0|Etc/UTC) TZ="UTC0" ;;
		CST-8|Asia/Shanghai) TZ="CST-8" ;;
		Asia/Tokyo) TZ="JST-9" ;;
		Asia/Seoul) TZ="KST-9" ;;
		Asia/Bangkok) TZ="<+07>-7" ;;
		Asia/Singapore) TZ="<+08>-8" ;;
		Asia/Dubai) TZ="<+04>-4" ;;
		Asia/Kolkata) TZ="IST-5:30" ;;
		Europe/London) TZ="GMT0BST,M3.5.0/1,M10.5.0/2" ;;
		Europe/Berlin) TZ="CET-1CEST,M3.5.0/2,M10.5.0/3" ;;
		Europe/Moscow) TZ="MSK-3" ;;
		Europe/Istanbul) TZ="<+03>-3" ;;
		Africa/Cairo) TZ="EET-2" ;;
		Africa/Johannesburg) TZ="SAST-2" ;;
		America/New_York) TZ="EST5EDT,M3.2.0/2,M11.1.0/2" ;;
		America/Chicago) TZ="CST6CDT,M3.2.0/2,M11.1.0/2" ;;
		America/Denver) TZ="MST7MDT,M3.2.0/2,M11.1.0/2" ;;
		America/Los_Angeles) TZ="PST8PDT,M3.2.0/2,M11.1.0/2" ;;
		America/Mexico_City) TZ="CST6" ;;
		America/Sao_Paulo) TZ="<+03>3" ;;
		America/Santiago) TZ="<+04>4<+03>,M9.1.6/24,M4.1.6/24" ;;
		America/Anchorage) TZ="AKST9AKDT,M3.2.0/2,M11.1.0/2" ;;
		Pacific/Honolulu) TZ="HST10" ;;
		Pacific/Auckland) TZ="NZST-12NZDT,M9.5.0/2,M4.1.0/3" ;;
		Australia/Perth) TZ="AWST-8" ;;
		Australia/Sydney) TZ="AEST-10AEDT,M10.1.0/2,M4.1.0/3" ;;
		*) TZ="UTC0" ;;
	esac
	export TZ
fi

is_running() {
	[ -f "${PIDFILE}" ] || return 1
	pid=$(cat "${PIDFILE}" 2>/dev/null)
	[ -n "${pid}" ] || return 1
	kill -0 "${pid}" 2>/dev/null
}

start_service() {
	[ -x "${DAEMON}" ] || return 0
	if is_running; then
		return 0
	fi

	mkdir -p "$(dirname "${LOGFILE}")"
	"${DAEMON}" >>"${LOGFILE}" 2>&1 &
	echo $! > "${PIDFILE}"
	sleep 1
	if ! is_running; then
		echo "rockbase-lcdui exited during startup" >>"${LOGFILE}"
		tail -n 20 "${LOGFILE}" 2>/dev/null
		return 1
	fi
}

stop_service() {
	if is_running; then
		pid=$(cat "${PIDFILE}" 2>/dev/null)
		kill "${pid}" >/dev/null 2>&1 || true
		sleep 1
		kill -9 "${pid}" >/dev/null 2>&1 || true
	fi
	rm -f "${PIDFILE}"
}

case "$1" in
	start)
		printf "Starting rockbase lcdui: "
		if start_service; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	stop)
		printf "Stopping rockbase lcdui: "
		stop_service
		echo "OK"
		;;
	restart|reload)
		"$0" stop
		sleep 1
		"$0" start
		;;
	status)
		if is_running; then
			echo "running (pid $(cat "${PIDFILE}"))"
		else
			echo "stopped"
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit 0
