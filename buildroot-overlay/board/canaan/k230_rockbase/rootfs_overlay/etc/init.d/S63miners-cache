#!/bin/sh
#
# S63miners-cache - Rockbase ckpool miners cache daemon
#

DAEMON=/usr/bin/rockbase_miners_cache.sh
PIDFILE=/var/run/rockbase-miners-cache.pid

find_pids() {
    for proc_dir in /proc/[0-9]*; do
        [ -r "${proc_dir}/cmdline" ] || continue
        ppid=$(awk '/^PPid:/ {print $2}' "${proc_dir}/status" 2>/dev/null)
        [ "${ppid}" = "1" ] || continue
        cmdline=$(tr '\000' ' ' 2>/dev/null < "${proc_dir}/cmdline")
        case " ${cmdline}" in *" ${DAEMON} daemon "*) echo "${proc_dir##*/}" ;; esac
    done
}

start_service() {
    if [ -n "$(find_pids)" ]; then
        return 0
    fi

    "${DAEMON}" daemon >/dev/null 2>&1 &
    return 0
}

stop_service() {
    if [ -f "${PIDFILE}" ]; then
        pid=$(cat "${PIDFILE}" 2>/dev/null)
        [ -n "${pid}" ] && kill "${pid}" >/dev/null 2>&1 || true
    fi

    pids=$(find_pids)
    [ -n "${pids}" ] && kill ${pids} >/dev/null 2>&1 || true

    sleep 1

    pids=$(find_pids)
    [ -n "${pids}" ] && kill -9 ${pids} >/dev/null 2>&1 || true
    rm -f "${PIDFILE}"
}

case "$1" in
    start)
        printf "Starting rockbase miners cache: "
        stop_service
        if start_service; then
            echo "OK"
        else
            echo "FAIL"
            exit 1
        fi
        ;;
    stop)
        printf "Stopping rockbase miners cache: "
        stop_service
        echo "OK"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
