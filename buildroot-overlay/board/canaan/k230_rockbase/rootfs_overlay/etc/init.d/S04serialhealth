#!/bin/sh

DAEMON=/usr/bin/rockbase_serial_healthd.sh
PIDFILE=/var/run/rockbase-serial-healthd.pid
INTERVAL=${ROCKBASE_SERIAL_HEALTH_INTERVAL:-1}
export TZ="${TZ:-CST-8}"

is_running() {
    [ -f "${PIDFILE}" ] || return 1
    pid="$(cat "${PIDFILE}" 2>/dev/null)"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null
}

start_service() {
    [ -x "${DAEMON}" ] || return 0
    if is_running; then
        return 0
    fi

    echo 8 4 1 7 >/proc/sys/kernel/printk 2>/dev/null || true
    [ -w /proc/sys/kernel/hung_task_timeout_secs ] && echo 60 >/proc/sys/kernel/hung_task_timeout_secs
    [ -w /proc/sys/kernel/hung_task_warnings ] && echo -1 >/proc/sys/kernel/hung_task_warnings
    [ -w /proc/sys/kernel/panic_on_oops ] && echo 1 >/proc/sys/kernel/panic_on_oops
    [ -w /proc/sys/kernel/panic ] && echo 10 >/proc/sys/kernel/panic
    [ -w /proc/sys/kernel/sysrq ] && echo 1 >/proc/sys/kernel/sysrq

    "${DAEMON}" "${INTERVAL}" >/dev/null 2>&1 &
    echo $! > "${PIDFILE}"
}

stop_service() {
    if is_running; then
        pid="$(cat "${PIDFILE}" 2>/dev/null)"
        kill "${pid}" >/dev/null 2>&1 || true
        sleep 1
        kill -9 "${pid}" >/dev/null 2>&1 || true
    fi
    rm -f "${PIDFILE}"
}

case "$1" in
    start)
        printf "Starting rockbase serial health: "
        if start_service; then
            echo "OK"
        else
            echo "FAIL"
            exit 1
        fi
        ;;
    stop)
        printf "Stopping rockbase serial health: "
        stop_service
        echo "OK"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if is_running; then
            echo "running (pid $(cat "${PIDFILE}"))"
        else
            echo "stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
