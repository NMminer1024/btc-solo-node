#!/bin/sh
#
# S60ntpd - One-shot NTP time sync (NOT a persistent daemon)
# K230 has no RTC battery; sync from network at boot.
# bitcoind requires time error < 10 min, otherwise consensus fails.
# Daily re-sync is handled by rockbase_heartbeatd.sh (checks every 60s,
# triggers at most once per 24h).
#

NTP_SYNC_STAMP=/tmp/rockbase-ntp-last-sync
# 3 servers: domestic + global redundancy (was 12; overkill for single-core)
NTP_SERVERS="-p cn.pool.ntp.org -p time.cloudflare.com -p pool.ntp.org"

do_sync() {
    ntpd -q ${NTP_SERVERS} 2>/dev/null
    if [ $? -eq 0 ]; then
        date +%s > "${NTP_SYNC_STAMP}"
        return 0
    fi
    return 1
}

case "$1" in
  start)
    printf "NTP sync: "
    if do_sync; then
        echo "OK"
    else
        echo "FAIL (heartbeatd will retry)"
    fi
    ;;
  stop)
    # No persistent daemon to stop
    echo "OK"
    ;;
  restart|reload)
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
