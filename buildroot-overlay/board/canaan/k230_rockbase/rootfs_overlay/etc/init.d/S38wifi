#!/bin/sh
#
# Auto-connect to WiFi on boot
#

WIFI_SSID="NMTech-2.4G"
WIFI_PASS="NMMiner2048"
WLAN_DEV="wlan0"

case "$1" in
  start)
        printf "Starting WiFi: "

        # Load driver if not already loaded
        if ! lsmod | grep -q 8189fs; then
                modprobe 8189fs 2>/dev/null
                sleep 2
        fi

        # Wait for wlan0 to appear (max 10 seconds)
        for i in $(seq 1 10); do
                [ -e /sys/class/net/${WLAN_DEV} ] && break
                sleep 1
        done

        if [ ! -e /sys/class/net/${WLAN_DEV} ]; then
                echo "FAIL (no ${WLAN_DEV})"
                exit 1
        fi

        # Disable Wi-Fi power saving to reduce long-lived connection stalls.
        iw dev ${WLAN_DEV} set power_save off 2>/dev/null || true
        iwconfig ${WLAN_DEV} power off 2>/dev/null || true

        # Generate wpa_supplicant config
        cat > /tmp/wpa_supplicant.conf << EOF
ctrl_interface=/var/run/wpa_supplicant
ap_scan=1

network={
        ssid="${WIFI_SSID}"
        psk="${WIFI_PASS}"
        key_mgmt=WPA-PSK
        scan_ssid=1
}
EOF

        # Kill any existing wpa_supplicant
        killall wpa_supplicant 2>/dev/null
        sleep 1

        # Start wpa_supplicant
        wpa_supplicant -D nl80211 -i ${WLAN_DEV} -c /tmp/wpa_supplicant.conf -B
        sleep 3

        # Get IP via DHCP
        if which udhcpc >/dev/null 2>&1; then
                udhcpc -i ${WLAN_DEV} -q -n -t 10
        elif which dhclient >/dev/null 2>&1; then
                dhclient ${WLAN_DEV}
        fi

        # Verify connection
        if ifconfig ${WLAN_DEV} | grep -q "inet addr:"; then
                echo "OK"
        else
                echo "FAIL (no IP)"
        fi
        ;;
  stop)
        printf "Stopping WiFi: "
        killall wpa_supplicant 2>/dev/null
        ifconfig ${WLAN_DEV} down 2>/dev/null
        echo "OK"
        ;;
  restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
