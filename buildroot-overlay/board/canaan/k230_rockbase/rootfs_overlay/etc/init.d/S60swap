#!/bin/sh
#
# S60swap - Enable zram swap on boot (in-RAM compressed swap, lz4)
#
# Replaces the former SD-card swapfile (disabled for SDIO freeze debug).
# zram keeps swap pages in RAM compressed, so it adds no SD I/O pressure.
# Requires kernel CONFIG_ZRAM=y (default comp lz4).
#

ZRAM_DEV=/dev/zram0
ZRAM_SYS=/sys/block/zram0
ZRAM_SIZE_MB=128
ZRAM_COMP=lz4

log() {
    echo "[S60swap] $*"
}

zram_active() {
    grep -q "^${ZRAM_DEV}[[:space:]]" /proc/swaps 2>/dev/null
}

enable_zram() {
    if [ ! -d "${ZRAM_SYS}" ]; then
        log "ERROR: ${ZRAM_SYS} not present (kernel built without zram?)"
        return 1
    fi

    if zram_active; then
        log "already active"
        return 0
    fi

    # Clear any stale state left over from a previous boot
    swapoff "${ZRAM_DEV}" >/dev/null 2>&1 || true
    echo 1 > "${ZRAM_SYS}/reset" 2>/dev/null || true

    echo "${ZRAM_COMP}" > "${ZRAM_SYS}/comp_algorithm" 2>/dev/null || true
    echo $((ZRAM_SIZE_MB * 1024 * 1024)) > "${ZRAM_SYS}/disksize" || return 1
    mkswap "${ZRAM_DEV}" >/dev/null 2>&1 || return 1
    swapon "${ZRAM_DEV}" >/dev/null 2>&1 || return 1
    return 0
}

case "$1" in
  start)
        printf "Starting zram swap: "
        if enable_zram; then
                echo "OK (${ZRAM_SIZE_MB}MB ${ZRAM_COMP})"
        else
                echo "FAIL"
                exit 1
        fi
        ;;
  stop)
        printf "Stopping zram swap: "
        if zram_active; then
                if swapoff "${ZRAM_DEV}" >/dev/null 2>&1; then
                        echo "OK"
                else
                        echo "FAIL"
                        exit 1
                fi
        else
                echo "already stopped"
        fi
        ;;
  restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
