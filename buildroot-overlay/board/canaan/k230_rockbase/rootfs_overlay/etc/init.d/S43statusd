#!/bin/sh
#
# S43statusd - Rockbase async web status cache daemon
#

DAEMON=/usr/bin/rockbase_statusd.sh
PIDFILE=/var/run/rockbase-statusd.pid
LOCKDIR=/var/run/rockbase-statusd.lock

find_pids() {
    for proc_dir in /proc/[0-9]*; do
        [ -r "${proc_dir}/cmdline" ] || continue
        ppid=$(awk '/^PPid:/ {print $2}' "${proc_dir}/status" 2>/dev/null)
        [ "${ppid}" = "1" ] || continue
        cmdline=$(tr '\000' ' ' 2>/dev/null < "${proc_dir}/cmdline")
        case " ${cmdline}" in *" ${DAEMON} daemon "*) echo "${proc_dir##*/}" ;; esac
    done
}

start_service() {
    if [ -n "$(find_pids)" ]; then
        return 0
    fi

    "${DAEMON}" daemon >/dev/null 2>&1 &
    return 0
}

stop_service() {
    if [ -f "${PIDFILE}" ]; then
        pid=$(cat "${PIDFILE}" 2>/dev/null)
        [ -n "${pid}" ] && kill "${pid}" >/dev/null 2>&1 || true
    fi
    if [ -r "${LOCKDIR}/pid" ]; then
        pid=$(cat "${LOCKDIR}/pid" 2>/dev/null)
        [ -n "${pid}" ] && kill "${pid}" >/dev/null 2>&1 || true
    fi

    pids=$(find_pids)
    [ -n "${pids}" ] && kill ${pids} >/dev/null 2>&1 || true

    sleep 1

    pids=$(find_pids)
    [ -n "${pids}" ] && kill -9 ${pids} >/dev/null 2>&1 || true
    rm -rf "${LOCKDIR}" >/dev/null 2>&1 || true
    rm -f "${PIDFILE}"
}

case "$1" in
    start)
        printf "Starting rockbase statusd: "
        stop_service
        /usr/bin/rockbase_boot_progress.sh 2 6 35 "#f0b44c" "Starting statusd..." 2>/dev/null || true
        if start_service; then
            echo "OK"
            /usr/bin/rockbase_boot_progress.sh 2 6 50 "#ffffff" "Status cache ready" 2>/dev/null || true
        else
            echo "FAIL"
            exit 1
        fi
        ;;
    stop)
        printf "Stopping rockbase statusd: "
        stop_service
        echo "OK"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
