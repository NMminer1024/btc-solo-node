#!/bin/sh
#
# Start the network....
#

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

	case "$1" in
  start)
	printf "Starting network: "
	if [ -e /sys/class/net/eth0 ] ;then  ifup eth0; fi
	/sbin/ifup -a
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	/usr/bin/rockbase_boot_progress.sh 1 6 15 "#f0b44c" "Starting network..." 2>/dev/null || true
	# details: link type + active interface + IP, e.g. "wifi wlan0 192.168.124.38"
	_IFACE=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $2}' | head -1)
	_IPADDR=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | head -1 | cut -d/ -f1)
	_NETTYPE="wired"
	[ "${_IFACE}" = "wlan0" ] && _NETTYPE="wifi"
	/usr/bin/rockbase_boot_progress.sh 1 6 30 "#ffffff" "Network ${_NETTYPE} ${_IFACE:-up} ${_IPADDR:-}" 2>/dev/null || true
	;;
  stop)
	printf "Stopping network: "
	[ -e /sys/class/net/wlan0 ] && ifdown wlan0
	[ -e /sys/class/net/eth0 ] && ifdown eth0
	/sbin/ifdown -a
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
