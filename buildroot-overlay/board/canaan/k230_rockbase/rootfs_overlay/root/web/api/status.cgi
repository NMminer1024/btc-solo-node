#!/bin/sh
# NM-miner JSON Status API
# Reads the pre-rendered async cache generated by rockbase_statusd.

CACHE_FILE=/tmp/status-api.json

echo "Content-Type: application/json; charset=utf-8"
echo ""

if [ -s "${CACHE_FILE}" ]; then
    cat "${CACHE_FILE}"
    exit 0
fi

printf '{\n'
printf '  "system": {"cpu_model":"--","uptime":"--","temp":"--","load_pct":null,"load_display":"--","load_avg_1":"--","load_avg_5":"--","load_avg_15":"--","load_avg_display":"--","mem_pct":null,"mem_used_display":"--","mem_free_display":"--","mem_total_display":"--","disk_pct":null,"disk_size_info":"--","swap_pct":null,"swap_used_display":"--","swap_total_display":"--","block_disk_found":false,"block_disk_value":"--","block_disk_path":"/root/block"},\n'
printf '  "bitcoin": {"running":0,"sync_key":"btc_not_running","sync_class":"err","sync_detail":"bitcoind not running","prune_key":"pruned_mode","prune_class":"soft","progress_pct":"0.000","progress_ring":0,"ibd_stage_key":"syncing","ibd_stage_label":"IBD Syncing","ibd_stage_detail":"","ibd_stage_height":"-","ibd_stage_pct":"","headers_fmt":"-","blocks_fmt":"-","best_block_date":"-","btc_context":"-","connections":"-","difficulty_display":"-","mempool_txs":"-","version":"-","rss":"N/A"},\n'
printf '  "mining": {"ckpool_running":0,"ckpool_class":"err","ckpool_state":"stopped","stratum_key":"unknown","stratum_port":3333,"stratum_url":"stratum+tcp://<device-ip>:3333","user_hint":"wallet.workername","pass_hint":"(leave blank)","recommended_mode":"LAN miners -> local Stratum","btc_address":"-","ckpool_tail":"-"},\n'
printf '  "network": {"wifi_ssid":"-","ip_addr":"N/A","iface":"wlan0","mac_addr":"N/A","rssi_display":"N/A","rssi_pct":0,"signal_level":0,"stratum_reach":"<device-ip>:3333","ntp_class":"err","ntp_key":"not_synced"}\n'
printf '}\n'
