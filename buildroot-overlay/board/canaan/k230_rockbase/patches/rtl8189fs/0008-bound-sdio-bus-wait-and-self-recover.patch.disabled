-		}
-		queued = rtw_sdio_bus_queue_depth_locked(dvobj);
-		irq_pending = dvobj->sdio_bus_irq_pending;
-		_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
-
-		pr_warn("[rb8189-bus] submit wait op=%s seq=%u submit=%u/%s waited_ms=%u worker=%s state_ms=%u active=%s/%u/%u/%s active_ms=%u queued=%u irq_pending=%u\n",
-			name ? name : "-", req.seq, req.submit_pid, req.submit_comm,
-			rtw_get_passing_time_ms(req.submit_time),
-			worker_state ? worker_state : "-", state_ms,
-			active_name ? active_name : "-", active_seq, active_pid,
-			active_comm, active_ms, queued, irq_pending);
-	}
-
-	return req.ret;
-}
+/* rb(0008): the RW submit path (rtw_sdio_bus_rw) replaced the old
+ * rtw_sdio_bus_call(); it lives next to rtw_sdio_bus_rw_fn below. */
 
 static void rtw_sdio_bus_run_irq(struct dvobj_priv *dvobj)
 {
@@ -527,7 +438,14 @@
 						  req->submit_pid, req->submit_comm, false);
 			req->ret = req->fn(dvobj, req->ctx);
 			rtw_sdio_bus_active_end(dvobj, req->ret);
+			/* rb(0008): the bus made forward progress, so clear any
+			 * fault a submit-timeout raised and let new ops resume. */
+			_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+			if (dvobj->sdio_bus_fault)
+				dvobj->sdio_bus_fault = 0;
+			_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
 			complete(&req->done);
+			rtw_sdio_bus_req_put(req);
 		}
 	}
 
@@ -1350,54 +1268,133 @@
 	return err;
 }
 
-struct rtw_sdio_bus_rw_ctx {
-	struct intf_hdl *pintfhdl;
-	struct sdio_func *func;
-	const char *op;
-	u32 addr;
-	u32 cnt;
-	void *pdata;
-	u32 seq;
-	bool trace;
-	bool write;
-};
-
 static int rtw_sdio_bus_rw_fn(struct dvobj_priv *dvobj, void *priv)
 {
-	struct rtw_sdio_bus_rw_ctx *ctx = priv;
+	struct rtw_sdio_bus_req *req = priv;
 	s32 err;
 
 	rtw_sdio_bus_lock(dvobj);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "before_claim", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
-	sdio_claim_host(ctx->func);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "claim_acquired", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "before_inner", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
-	if (ctx->write)
-		err = _sd_write(ctx->pintfhdl, ctx->addr, ctx->cnt, ctx->pdata);
+	sdio_claim_host(req->func);
+	if (req->write)
+		err = _sd_write(req->pintfhdl, req->addr, req->cnt, req->bounce);
 	else
-		err = _sd_read(ctx->pintfhdl, ctx->addr, ctx->cnt, ctx->pdata);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "after_inner", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "before_release", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
-	sdio_release_host(ctx->func);
-	if (ctx->trace)
-		rb8189_diag_sdio_mark(ctx->op, "release_done", ctx->seq,
-				      ctx->addr, ctx->cnt, true);
+		err = _sd_read(req->pintfhdl, req->addr, req->cnt, req->bounce);
+	sdio_release_host(req->func);
 	rtw_sdio_bus_unlock(dvobj);
 
 	return err;
 }
 
 /*
+ * rb(0008): submit one CMD53 through the bus worker with a bounded wait.
+ *
+ * The request and its data bounce buffer are heap-owned and reference
+ * counted, so if the underlying transfer wedges the submitter can abandon
+ * the wait after RB8189_BUS_SUBMIT_TIMEOUT_MS and return an error instead of
+ * blocking forever. The worker only ever touches the heap request and its
+ * bounce buffer, never the caller's stack/buffer, so abandoning is safe.
+ * A timeout marks the bus faulted so further ops fast-fail; the worker
+ * clears the fault once it makes forward progress again (self-recovery).
+ *
+ * Returns -EOPNOTSUPP if the worker path is unavailable so the caller can
+ * fall back to the direct SDIO path.
+ */
+static int rtw_sdio_bus_rw(struct dvobj_priv *dvobj, const char *name,
+			   struct intf_hdl *pintfhdl, struct sdio_func *func,
+			   u32 addr, u32 cnt, void *pdata, bool write)
+{
+	struct rtw_sdio_bus_req *req;
+	unsigned long left;
+	int ret = 0;
+	_irqL irqL;
+
+	if (!dvobj->sdio_bus_thread || dvobj->sdio_bus_thread == current)
+		return -EOPNOTSUPP;
+
+	req = (struct rtw_sdio_bus_req *)rtw_zmalloc(sizeof(*req));
+	if (!req)
+		return -EOPNOTSUPP;
+	req->bounce = rtw_malloc(cnt ? cnt : 1);
+	if (!req->bounce) {
+		rtw_mfree((u8 *)req, sizeof(*req));
+		return -EOPNOTSUPP;
+	}
+
+	INIT_LIST_HEAD(&req->list);
+	init_completion(&req->done);
+	req->fn = rtw_sdio_bus_rw_fn;
+	req->ctx = req;
+	req->name = name;
+	req->addr = addr;
+	req->cnt = cnt;
+	req->submit_time = rtw_get_current_time();
+	req->submit_pid = current->pid;
+	snprintf(req->submit_comm, TASK_COMM_LEN, "%s", current->comm);
+	req->ret = -EINPROGRESS;
+	req->heap = 1;
+	req->write = write ? 1 : 0;
+	req->pintfhdl = pintfhdl;
+	req->func = func;
+	req->bounce_cnt = cnt ? cnt : 1;
+	atomic_set(&req->refcnt, 1);
+	if (write && cnt)
+		_rtw_memcpy(req->bounce, pdata, cnt);
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	if (dvobj->sdio_bus_stopping || dvobj->sdio_bus_fault) {
+		ret = -ESHUTDOWN;
+	} else {
+		u32 depth;
+
+		atomic_inc(&req->refcnt);
+		req->seq = ++dvobj->sdio_bus_seq;
+		list_add_tail(&req->list, &dvobj->sdio_bus_req_q);
+		dvobj->sdio_bus_total_queued++;
+		depth = rtw_sdio_bus_queue_depth_locked(dvobj);
+		if (depth > dvobj->sdio_bus_max_queue_depth)
+			dvobj->sdio_bus_max_queue_depth = depth;
+	}
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	if (ret) {
+		rtw_sdio_bus_req_put(req);
+		return ret;
+	}
+
+	_rtw_up_sema(&dvobj->sdio_bus_req_sema);
+
+	left = wait_for_completion_timeout(&req->done,
+					   msecs_to_jiffies(RB8189_BUS_SUBMIT_TIMEOUT_MS));
+	if (!left) {
+		bool still_queued = false;
+
+		_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+		req->abandoned = 1;
+		if (!list_empty(&req->list)) {
+			list_del_init(&req->list);
+			still_queued = true;
+		}
+		dvobj->sdio_bus_fault = 1;
+		_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+		pr_warn("[rb8189-bus] submit timeout op=%s seq=%u submit=%u/%s waited_ms=%u still_queued=%u -> abandon+recover\n",
+			name ? name : "-", req->seq, req->submit_pid, req->submit_comm,
+			rtw_get_passing_time_ms(req->submit_time), still_queued ? 1 : 0);
+
+		if (still_queued)
+			rtw_sdio_bus_req_put(req);
+		rtw_sdio_bus_req_put(req);
+		return -ETIMEDOUT;
+	}
+
+	ret = req->ret;
+	if (!ret && !write && cnt)
+		_rtw_memcpy(pdata, req->bounce, cnt);
+	rtw_sdio_bus_req_put(req);
+	return ret;
+}
+
+/*
  * Use CMD53 to read data from SDIO device.
  *
  * Parameters:
@@ -1437,23 +1434,12 @@
 	trace = rb8189_diag_sdio_enter("sd_read", addr, cnt, claim_needed, &seq);
 
 	if (claim_needed) {
-		struct rtw_sdio_bus_rw_ctx bus_ctx = {
-			.pintfhdl = pintfhdl,
-			.func = func,
-			.op = "sd_read",
-			.addr = addr,
-			.cnt = cnt,
-			.pdata = pdata,
-			.seq = seq,
-			.trace = trace,
-			.write = false,
-		};
 		int bus_ret;
 
 		if (trace)
 			rb8189_diag_sdio_mark("sd_read", "queue_bus", seq, addr, cnt, claim_needed);
-		bus_ret = rtw_sdio_bus_call(psdiodev, "sd_read", addr, cnt,
-					    rtw_sdio_bus_rw_fn, &bus_ctx);
+		bus_ret = rtw_sdio_bus_rw(psdiodev, "sd_read", pintfhdl, func,
+					  addr, cnt, pdata, false);
 		if (bus_ret != -EOPNOTSUPP) {
 			err = bus_ret;
 			if (trace)
@@ -1604,23 +1590,12 @@
 	trace = rb8189_diag_sdio_enter("sd_write", addr, cnt, claim_needed, &seq);
 
 	if (claim_needed) {
-		struct rtw_sdio_bus_rw_ctx bus_ctx = {
-			.pintfhdl = pintfhdl,
-			.func = func,
-			.op = "sd_write",
-			.addr = addr,
-			.cnt = cnt,
-			.pdata = pdata,
-			.seq = seq,
-			.trace = trace,
-			.write = true,
-		};
 		int bus_ret;
 
 		if (trace)
 			rb8189_diag_sdio_mark("sd_write", "queue_bus", seq, addr, cnt, claim_needed);
-		bus_ret = rtw_sdio_bus_call(psdiodev, "sd_write", addr, cnt,
-					    rtw_sdio_bus_rw_fn, &bus_ctx);
+		bus_ret = rtw_sdio_bus_rw(psdiodev, "sd_write", pintfhdl, func,
+					  addr, cnt, pdata, true);
 		if (bus_ret != -EOPNOTSUPP) {
 			err = bus_ret;
 			if (trace)
-- 
2.34.1
