 #include <drv_types.h>
 #include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/err.h>
+#include <linux/jiffies.h>
 
 #define RB8189_DIAG_SLOW_SDIO_MS 200
 #define RB8189_DIAG_PERIOD_MS 30000
+#define RB8189_BUS_WATCHDOG_PERIOD_MS 1000
+#define RB8189_BUS_STUCK_WARN_MS 3000
+#define RB8189_BUS_STUCK_RECOVER_MS 8000
 static atomic_t rb8189_diag_sdio_seq = ATOMIC_INIT(0);
 
 static bool rb8189_diag_ratelimit(systime *last, u32 period_ms)
@@ -100,6 +106,335 @@
 {
 	_exit_critical_mutex(&dvobj->sdio_claim_mutex, NULL);
 }
+
+struct rtw_sdio_bus_req {
+	_list list;
+	int (*fn)(struct dvobj_priv *dvobj, void *ctx);
+	void *ctx;
+	const char *name;
+	u32 addr;
+	u32 cnt;
+	u32 seq;
+	u32 submit_pid;
+	char submit_comm[TASK_COMM_LEN];
+	int ret;
+	struct completion done;
+};
+
+static void rtw_sdio_bus_fail_queued(struct dvobj_priv *dvobj, int ret)
+{
+	struct rtw_sdio_bus_req *req, *tmp;
+	_list local;
+	_irqL irqL;
+
+	INIT_LIST_HEAD(&local);
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	list_splice_init(&dvobj->sdio_bus_req_q, &local);
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	list_for_each_entry_safe(req, tmp, &local, list) {
+		list_del_init(&req->list);
+		req->ret = ret;
+		complete(&req->done);
+	}
+}
+
+static void rtw_sdio_bus_active_begin(struct dvobj_priv *dvobj,
+				      const char *name, u32 seq,
+				      u32 addr, u32 cnt,
+				      u32 submit_pid, const char *submit_comm,
+				      bool is_irq)
+{
+	_irqL irqL;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	dvobj->sdio_bus_active_name = name;
+	dvobj->sdio_bus_active_seq = seq;
+	dvobj->sdio_bus_active_addr = addr;
+	dvobj->sdio_bus_active_cnt = cnt;
+	dvobj->sdio_bus_active_submit_pid = submit_pid;
+	dvobj->sdio_bus_active_is_irq = is_irq ? 1 : 0;
+	dvobj->sdio_bus_active_start = rtw_get_current_time();
+	dvobj->sdio_bus_last_watchdog = 0;
+	snprintf(dvobj->sdio_bus_active_comm, TASK_COMM_LEN, "%s",
+		 submit_comm ? submit_comm : "-");
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+}
+
+static void rtw_sdio_bus_active_end(struct dvobj_priv *dvobj)
+{
+	_irqL irqL;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	dvobj->sdio_bus_active_name = NULL;
+	dvobj->sdio_bus_active_seq = 0;
+	dvobj->sdio_bus_active_addr = 0;
+	dvobj->sdio_bus_active_cnt = 0;
+	dvobj->sdio_bus_active_submit_pid = 0;
+	dvobj->sdio_bus_active_is_irq = 0;
+	dvobj->sdio_bus_active_start = 0;
+	dvobj->sdio_bus_last_watchdog = 0;
+	dvobj->sdio_bus_active_comm[0] = '\0';
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+}
+
+static void rtw_sdio_bus_watchdog_hdl(void *ctx)
+{
+	struct dvobj_priv *dvobj = ctx;
+	PADAPTER padapter;
+	const char *name = NULL;
+	char comm[TASK_COMM_LEN];
+	u32 seq = 0, addr = 0, cnt = 0, submit_pid = 0, elapsed = 0;
+	u8 is_irq = 0, irq_pending = 0, recover = 0, stopping = 0;
+	bool warn = false;
+	_irqL irqL;
+
+	if (!dvobj || !dvobj->sdio_bus_thread)
+		return;
+
+	comm[0] = '\0';
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	stopping = dvobj->sdio_bus_stopping;
+	if (dvobj->sdio_bus_active_start) {
+		elapsed = rtw_get_passing_time_ms(dvobj->sdio_bus_active_start);
+		if (elapsed >= RB8189_BUS_STUCK_WARN_MS &&
+		    (!dvobj->sdio_bus_last_watchdog ||
+		     rtw_get_passing_time_ms(dvobj->sdio_bus_last_watchdog) >= RB8189_BUS_WATCHDOG_PERIOD_MS)) {
+			name = dvobj->sdio_bus_active_name;
+			seq = dvobj->sdio_bus_active_seq;
+			addr = dvobj->sdio_bus_active_addr;
+			cnt = dvobj->sdio_bus_active_cnt;
+			submit_pid = dvobj->sdio_bus_active_submit_pid;
+			is_irq = dvobj->sdio_bus_active_is_irq;
+			irq_pending = dvobj->sdio_bus_irq_pending;
+			snprintf(comm, TASK_COMM_LEN, "%s", dvobj->sdio_bus_active_comm);
+			dvobj->sdio_bus_last_watchdog = rtw_get_current_time();
+			warn = true;
+		}
+		if (elapsed >= RB8189_BUS_STUCK_RECOVER_MS && !dvobj->sdio_bus_fault) {
+			dvobj->sdio_bus_fault = 1;
+			recover = 1;
+		}
+	}
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	if (warn)
+		pr_warn("[rb8189-bus] watchdog op=%s seq=%u submit=%u/%s irq=%u addr=0x%05x cnt=%u elapsed_ms=%u irq_pending=%u\n",
+			name ? name : "-", seq, submit_pid, comm, is_irq,
+			addr, cnt, elapsed, irq_pending);
+
+	if (recover) {
+		pr_warn("[rb8189-bus] watchdog recovery: mark surprise_removed and fail queued SDIO bus requests\n");
+		padapter = dvobj_get_primary_adapter(dvobj);
+		if (padapter)
+			rtw_set_surprise_removed(padapter);
+		rtw_sdio_bus_fail_queued(dvobj, -ETIMEDOUT);
+	}
+
+	if (!stopping)
+		_set_timer(&dvobj->sdio_bus_watchdog_timer, RB8189_BUS_WATCHDOG_PERIOD_MS);
+}
+
+static int rtw_sdio_bus_call(struct dvobj_priv *dvobj, const char *name,
+			     u32 addr, u32 cnt,
+			     int (*fn)(struct dvobj_priv *dvobj, void *ctx),
+			     void *ctx)
+{
+	struct rtw_sdio_bus_req req;
+	int ret = 0;
+	_irqL irqL;
+
+	if (!dvobj->sdio_bus_thread || dvobj->sdio_bus_thread == current)
+		return -EOPNOTSUPP;
+
+	INIT_LIST_HEAD(&req.list);
+	init_completion(&req.done);
+	req.fn = fn;
+	req.ctx = ctx;
+	req.name = name;
+	req.addr = addr;
+	req.cnt = cnt;
+	req.submit_pid = current->pid;
+	snprintf(req.submit_comm, TASK_COMM_LEN, "%s", current->comm);
+	req.ret = -EINPROGRESS;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	if (dvobj->sdio_bus_stopping || dvobj->sdio_bus_fault) {
+		ret = -ESHUTDOWN;
+	} else {
+		req.seq = ++dvobj->sdio_bus_seq;
+		list_add_tail(&req.list, &dvobj->sdio_bus_req_q);
+	}
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	if (ret)
+		return ret;
+
+	_rtw_up_sema(&dvobj->sdio_bus_req_sema);
+	wait_for_completion(&req.done);
+
+	return req.ret;
+}
+
+static void rtw_sdio_bus_run_irq(struct dvobj_priv *dvobj)
+{
+	struct sdio_func *func = dvobj_to_sdio_func(dvobj);
+	PADAPTER padapter = dvobj_get_primary_adapter(dvobj);
+	systime start;
+	u32 elapsed, seq;
+	_irqL irqL;
+
+	if (!func || !padapter)
+		return;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	seq = ++dvobj->sdio_bus_seq;
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	start = rtw_get_current_time();
+	rtw_sdio_bus_active_begin(dvobj, "sdio_irq", seq, 0, 0, 0, "sdio_irq", true);
+	rtw_sdio_bus_lock(dvobj);
+	sdio_claim_host(func);
+	rtw_sdio_set_irq_thd(dvobj, current);
+	sd_int_hdl(padapter);
+	rtw_sdio_set_irq_thd(dvobj, NULL);
+	sdio_release_host(func);
+	rtw_sdio_bus_unlock(dvobj);
+	rtw_sdio_bus_active_end(dvobj);
+
+	elapsed = rtw_get_passing_time_ms(start);
+	if (elapsed >= RB8189_DIAG_SLOW_SDIO_MS)
+		pr_warn("[rb8189-bus] irq done seq=%u pid=%d comm=%s elapsed_ms=%u\n",
+			seq, current->pid, current->comm, elapsed);
+}
+
+static int rtw_sdio_bus_thread(void *ctx)
+{
+	struct dvobj_priv *dvobj = ctx;
+
+	thread_enter("RTW_SDIO_BUS");
+
+	while (!kthread_should_stop()) {
+		if (_rtw_down_sema(&dvobj->sdio_bus_req_sema) == _FAIL) {
+			if (kthread_should_stop())
+				break;
+			continue;
+		}
+
+		while (!kthread_should_stop()) {
+			struct rtw_sdio_bus_req *req = NULL;
+			bool run_irq = false;
+			_irqL irqL;
+
+			_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+			if (dvobj->sdio_bus_irq_pending) {
+				dvobj->sdio_bus_irq_pending = 0;
+				run_irq = true;
+			} else if (!list_empty(&dvobj->sdio_bus_req_q)) {
+				req = list_first_entry(&dvobj->sdio_bus_req_q,
+						       struct rtw_sdio_bus_req, list);
+				list_del_init(&req->list);
+			}
+			_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+			if (run_irq) {
+				rtw_sdio_bus_run_irq(dvobj);
+				continue;
+			}
+			if (!req)
+				break;
+
+			rtw_sdio_bus_active_begin(dvobj, req->name, req->seq,
+						  req->addr, req->cnt,
+						  req->submit_pid, req->submit_comm, false);
+			req->ret = req->fn(dvobj, req->ctx);
+			rtw_sdio_bus_active_end(dvobj);
+			complete(&req->done);
+		}
+	}
+
+	rtw_sdio_bus_fail_queued(dvobj, -ESHUTDOWN);
+	rtw_thread_wait_stop();
+	return 0;
+}
+
+int rtw_sdio_bus_init(struct dvobj_priv *dvobj)
+{
+	if (!dvobj)
+		return -EINVAL;
+
+	_rtw_spinlock_init(&dvobj->sdio_bus_req_lock);
+	_rtw_init_sema(&dvobj->sdio_bus_req_sema, 0);
+	INIT_LIST_HEAD(&dvobj->sdio_bus_req_q);
+	_init_timer(&dvobj->sdio_bus_watchdog_timer, NULL,
+		    rtw_sdio_bus_watchdog_hdl, dvobj);
+	dvobj->sdio_bus_stopping = 0;
+	dvobj->sdio_bus_fault = 0;
+	dvobj->sdio_bus_irq_pending = 0;
+	dvobj->sdio_bus_seq = 0;
+	dvobj->sdio_bus_thread = kthread_run(rtw_sdio_bus_thread, dvobj,
+					     "RTW_SDIO_BUS");
+	if (IS_ERR(dvobj->sdio_bus_thread)) {
+		pr_warn("[rb8189-bus] failed to start SDIO bus worker err=%ld; fallback to direct SDIO path\n",
+			PTR_ERR(dvobj->sdio_bus_thread));
+		dvobj->sdio_bus_thread = NULL;
+		_rtw_free_sema(&dvobj->sdio_bus_req_sema);
+		_rtw_spinlock_free(&dvobj->sdio_bus_req_lock);
+		return -ENOMEM;
+	}
+
+	_set_timer(&dvobj->sdio_bus_watchdog_timer, RB8189_BUS_WATCHDOG_PERIOD_MS);
+	pr_warn("[rb8189-bus] SDIO bus worker started\n");
+	return 0;
+}
+
+void rtw_sdio_bus_deinit(struct dvobj_priv *dvobj)
+{
+	u8 cancelled = 0;
+	_irqL irqL;
+
+	if (!dvobj || !dvobj->sdio_bus_thread)
+		return;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	dvobj->sdio_bus_stopping = 1;
+	dvobj->sdio_bus_irq_pending = 0;
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	_cancel_timer(&dvobj->sdio_bus_watchdog_timer, &cancelled);
+	rtw_sdio_bus_fail_queued(dvobj, -ESHUTDOWN);
+	_rtw_up_sema(&dvobj->sdio_bus_req_sema);
+	kthread_stop((struct task_struct *)dvobj->sdio_bus_thread);
+	dvobj->sdio_bus_thread = NULL;
+	_rtw_free_sema(&dvobj->sdio_bus_req_sema);
+	_rtw_spinlock_free(&dvobj->sdio_bus_req_lock);
+}
+
+int rtw_sdio_bus_schedule_irq(struct dvobj_priv *dvobj)
+{
+	bool wake = false;
+	int ret = 0;
+	_irqL irqL;
+
+	if (!dvobj || !dvobj->sdio_bus_thread)
+		return -EOPNOTSUPP;
+
+	_enter_critical(&dvobj->sdio_bus_req_lock, &irqL);
+	if (dvobj->sdio_bus_stopping || dvobj->sdio_bus_fault) {
+		ret = 0;
+	} else if (!dvobj->sdio_bus_irq_pending) {
+		dvobj->sdio_bus_irq_pending = 1;
+		wake = true;
+	}
+	_exit_critical(&dvobj->sdio_bus_req_lock, &irqL);
+
+	if (wake)
+		_rtw_up_sema(&dvobj->sdio_bus_req_sema);
+
+	return ret;
+}
