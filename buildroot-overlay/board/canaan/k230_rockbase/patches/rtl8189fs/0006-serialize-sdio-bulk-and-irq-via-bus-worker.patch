+struct rtw_sdio_bus_rw_ctx {
+	struct intf_hdl *pintfhdl;
+	struct sdio_func *func;
+	const char *op;
+	u32 addr;
+	u32 cnt;
+	void *pdata;
+	u32 seq;
+	bool trace;
+	bool write;
+};
+
+static int rtw_sdio_bus_rw_fn(struct dvobj_priv *dvobj, void *priv)
+{
+	struct rtw_sdio_bus_rw_ctx *ctx = priv;
+	s32 err;
+
+	rtw_sdio_bus_lock(dvobj);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "before_claim", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	sdio_claim_host(ctx->func);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "claim_acquired", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "before_inner", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	if (ctx->write)
+		err = _sd_write(ctx->pintfhdl, ctx->addr, ctx->cnt, ctx->pdata);
+	else
+		err = _sd_read(ctx->pintfhdl, ctx->addr, ctx->cnt, ctx->pdata);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "after_inner", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "before_release", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	sdio_release_host(ctx->func);
+	if (ctx->trace)
+		rb8189_diag_sdio_mark(ctx->op, "release_done", ctx->seq,
+				      ctx->addr, ctx->cnt, true);
+	rtw_sdio_bus_unlock(dvobj);
+
+	return err;
+}
+
 /*
