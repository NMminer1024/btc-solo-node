From: RockBase SDK <dev@rockbase.local>
Subject: [PATCH] riscv: dts: canaan: rockbase-2g set touchscreen size

Set touchscreen-size-x/y on 2G variant to align input scaling with 1G.

---
--- a/arch/riscv/boot/dts/canaan/k230-rockbase-2g-lcd.dts
+++ b/arch/riscv/boot/dts/canaan/k230-rockbase-2g-lcd.dts
@@ -34,6 +34,14 @@
 	};
 };
 
+&i2c3 {
+	touchscreen@38 {
+		touchscreen-size-x = <480>;
+		touchscreen-size-y = <800>;
+	};
+};
+
+
 &vo {
 	background = <0x808000>;
 };
