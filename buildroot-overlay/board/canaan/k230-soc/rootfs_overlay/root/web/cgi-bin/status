#!/bin/sh
#
# K230 Miner Dashboard — Shell CGI
# 用法: httpd -h /root/web -p 80
#

CONF=/root/bitcoind/bitcoin.conf
DATADIR=/root/block

# ── helper: 安全取值 ──
safe() { echo "$1" | tr -d '\r\n'; }

# ── helper: bitcoin-cli 出错时返回默认值 ──
btc_cli() {
    bitcoin-cli -conf="$CONF" -datadir="$DATADIR" "$@" 2>/dev/null || echo "{}"
}

# ── 系统信息 ──
cpu_model=$(grep -m1 "isa" /proc/cpuinfo | cut -d: -f2 | xargs)
uptime_sec=$(awk -F. '{print $1}' /proc/uptime)
uptime_fmt=$(printf '%dd %02dh:%02dm' $((uptime_sec/86400)) $((uptime_sec%86400/3600)) $((uptime_sec%3600/60)))
load=$(awk '{print $1", "$2", "$3}' /proc/loadavg)
mem_total=$(awk '/^MemTotal/{printf "%.0f", $2/1024}' /proc/meminfo)
mem_free=$(awk '/^MemAvailable/{printf "%.0f", $2/1024}' /proc/meminfo)
mem_used=$((mem_total - mem_free))
mem_pct=$((mem_used * 100 / mem_total))
disk_info=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5" used)"}')
# 温度 (多路径尝试)
temp="N/A"
for t in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp1_input; do
    [ -r "$t" ] && temp=$(awk '{printf "%.1f", $1/1000}' "$t") && break
done

# ── Bitcoin 信息 ──
btc_info=$(btc_cli getblockchaininfo)
btc_net=$(btc_cli getnetworkinfo)

headers=$(echo "$btc_info" | grep -o '"headers": *[0-9]*' | grep -o '[0-9]*')
blocks=$(echo "$btc_info" | grep -o '"blocks": *[0-9]*' | grep -o '[0-9]*')
progress=$(echo "$btc_info" | grep -o '"verificationprogress": *[0-9.e+-]*' | cut -d: -f2)
ibd=$(echo "$btc_info" | grep -o '"initialblockdownload": *[a-z]*' | grep -o 'true\|false')
chain=$(echo "$btc_info" | grep -o '"chain": *"[^"]*"' | cut -d'"' -f4)
difficulty=$(echo "$btc_info" | grep -o '"difficulty": *[0-9.]*' | cut -d: -f2 | xargs)
prune_info=$(echo "$btc_info" | grep -o '"prune_target_size": *[0-9]*' | cut -d: -f2)
connections=$(echo "$btc_net" | grep -o '"connections": *[0-9]*' | grep -o '[0-9]*')
subversion=$(echo "$btc_net" | grep -o '"subversion": *"[^"]*"' | cut -d'"' -f4)

# IBD 进度百分比
if [ -n "$progress" ] && [ "$progress" != "null" ]; then
    progress_pct=$(echo "$progress" | awk '{printf "%.2f", $1*100}')
else
    progress_pct="0.00"
fi

# 同步状态
if [ "$ibd" = "true" ]; then
    sync_status="⏳ IBD 同步中"
else
    sync_status="✅ 已同步"
fi

# dbcache
dbcache_actual=$(cat /proc/$(pidof bitcoind 2>/dev/null || echo 0)/status 2>/dev/null | awk '/^VmRSS/{printf "%.0f", $2/1024}')
[ -z "$dbcache_actual" ] && dbcache_actual="N/A"

# ── ckpool 信息 ──
ckpool_running="❌ 未运行"
ckpool_log_tail=""
if ps | grep -v grep | grep -q ckpool; then
    ckpool_running="✅ 运行中"
    ckpool_log_tail=$(tail -5 /root/ckpool/logs/ckpool.log 2>/dev/null | sed 's/</\&lt;/g; s/>/\&gt;/g')
fi

# ── 网络 ──
wifi_ssid=$(iwconfig 2>/dev/null | grep -o 'ESSID:"[^"]*"' | cut -d'"' -f2 || echo "N/A")
ip_addr=$(ip addr show wlan0 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
[ -z "$ip_addr" ] && ip_addr=$(ip addr show eth0 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
[ -z "$ip_addr" ] && ip_addr="N/A"

ntp_ok="❌ 未同步"
ps | grep -v grep | grep -q ntpd && ntp_ok="✅ 正常运行"

# ── 输出 HTML ──
echo "Content-Type: text/html; charset=utf-8"
echo ""

cat <<EOF
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>NMminer K230 Dashboard</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',monospace;background:#0d1117;color:#c9d1d9;min-height:100vh}
h1{font-size:1.4rem;color:#f0f6fc;margin-bottom:2px}
.sub{color:#8b949e;font-size:0.85rem;margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;padding:0 16px 16px}
.card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:16px}
.card h2{font-size:1rem;color:#58a6ff;margin-bottom:12px;border-bottom:1px solid #21262d;padding-bottom:8px}
.card table{width:100%;border-collapse:collapse}
.card td{padding:5px 4px;font-size:0.88rem;word-break:break-all}
.card td:first-child{color:#8b949e;white-space:nowrap;padding-right:12px;vertical-align:top}
.bar-bg{background:#21262d;border-radius:4px;height:16px;overflow:hidden;margin-top:4px}
.bar-fill{background:linear-gradient(90deg,#238636,#3fb950);height:100%;border-radius:4px;transition:width .5s}
.bar-text{font-size:0.75rem;color:#8b949e;text-align:right}
.badge-ok{color:#3fb950;font-weight:bold}
.badge-warn{color:#d29922;font-weight:bold}
.badge-off{color:#f85149}
.log-box{background:#0d1117;border:1px solid #30363d;border-radius:4px;padding:8px;max-height:120px;overflow-y:auto;font-size:0.75rem;color:#8b949e;white-space:pre-wrap;word-break:break-all}
.refresh{text-align:center;color:#484f58;font-size:0.7rem;padding:8px}
</style>
</head>
<body>
<div style="padding:20px 16px 0">
<h1>⛏️ NMminer K230 RockBase</h1>
<div class="sub">Bitcoin Full Node + Solo Mining Pool | 自动刷新 10s</div>
</div>

<div class="grid">
<!-- 系统信息 -->
<div class="card">
<h2>💻 系统信息</h2>
<table>
<tr><td>CPU</td><td>$cpu_model</td></tr>
<tr><td>负载</td><td>$load</td></tr>
<tr><td>运行时间</td><td>$uptime_fmt</td></tr>
<tr><td>温度</td><td>${temp}°C</td></tr>
<tr><td>内存</td><td>
  ${mem_used}M / ${mem_total}M (${mem_pct}%)
  <div class="bar-bg"><div class="bar-fill" style="width:${mem_pct}%"></div></div>
</td></tr>
<tr><td>磁盘</td><td>$disk_info</td></tr>
</table>
</div>

<!-- Bitcoin 节点 -->
<div class="card">
<h2>⛓️ Bitcoin 节点</h2>
<table>
<tr><td>链</td><td>$chain ($subversion)</td></tr>
<tr><td>状态</td><td class="badge-ok">$sync_status</td></tr>
<tr><td>区块高度</td><td>$headers / $blocks</td></tr>
<tr><td>IBD 进度</td><td>
  ${progress_pct}%
  <div class="bar-bg"><div class="bar-fill" style="width:${progress_pct}%"></div></div>
</td></tr>
<tr><td>连接数</td><td>$connections</td></tr>
<tr><td>难度</td><td>$difficulty</td></tr>
<tr><td>RSS 内存</td><td>${dbcache_actual}M</td></tr>
</table>
</div>

<!-- 挖矿状态 -->
<div class="card">
<h2>⛏️ 挖矿状态</h2>
<table>
<tr><td>ckpool</td><td class="badge-ok">$ckpool_running</td></tr>
<tr><td>NTP 时间</td><td>$ntp_ok</td></tr>
<tr><td>BTC 地址</td><td>18dK8...Pto1</td></tr>
</table>
EOF

# 有 ckpool 日志时显示
if [ -n "$ckpool_log_tail" ]; then
    echo '<div style="margin-top:10px;color:#8b949e;font-size:0.8rem">📋 最近日志</div>'
    echo "<div class='log-box'>$ckpool_log_tail</div>"
fi

cat <<EOF
</div>

<!-- 网络 -->
<div class="card">
<h2>🌐 网络</h2>
<table>
<tr><td>IP 地址</td><td>$ip_addr</td></tr>
<tr><td>WiFi</td><td>$wifi_ssid</td></tr>
<tr><td>NTP</td><td>$ntp_ok</td></tr>
</table>
</div>
</div>

<div class="refresh">页面每 10 秒自动刷新 | Powered by Busybox httpd + Shell CGI</div>
</body>
</html>
EOF