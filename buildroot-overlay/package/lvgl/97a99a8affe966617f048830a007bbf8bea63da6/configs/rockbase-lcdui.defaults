# Minimal LVGL profile for Rockbase onboard LCD UI.
LV_COLOR_DEPTH 32
LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB
LV_USE_DRAW_SW_ASM LV_DRAW_SW_ASM_NONE

# The Rockbase UI owns K230 DRM commits through the display package.
LV_USE_LINUX_FBDEV 0
LV_USE_LINUX_DRM 0
LV_USE_LINUX_DRM_GBM_BUFFERS 0
LV_USE_SDL 0
LV_USE_WAYLAND 0
LV_USE_GLFW 0

# No touch input is needed for the boot/logo stage.
LV_USE_EVDEV 0
LV_USE_LIBINPUT 0

# Built-in fonts used by the placeholder UI.
LV_FONT_MONTSERRAT_16 1
LV_FONT_MONTSERRAT_18 1
LV_FONT_MONTSERRAT_22 1
LV_FONT_MONTSERRAT_32 1
LV_FONT_MONTSERRAT_36 1
LV_FONT_DEFAULT &lv_font_montserrat_16

# Resource loading for the next boot-logo step.
LV_USE_FS_STDIO 1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER 'A'
LV_USE_LODEPNG 1
LV_BIN_DECODER_RAM_LOAD 1

# Keep the UI runtime small.
LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0
LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1
LV_USE_SYSMON 0
LV_USE_PERF_MONITOR 0
LV_USE_OBJ_NAME 0
LV_USE_FLOAT 0
LV_USE_MATRIX 0
LV_USE_VECTOR_GRAPHIC 0
LV_USE_THORVG_INTERNAL 0
LV_USE_LOTTIE 0
LV_DRAW_LAYER_SIMPLE_BUF_SIZE (128 * 1024)
