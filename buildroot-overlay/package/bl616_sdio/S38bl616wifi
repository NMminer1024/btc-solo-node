#!/bin/sh

DAEMON=/usr/sbin/bflbwifid
PIDFILE=/var/run/bflbwifid.pid

case "$1" in
  start)
    modprobe mr_sdio || exit 1
    sleep 1
    [ -x "$DAEMON" ] || exit 1
    "$DAEMON" -c vchan -P "$PIDFILE" -l /tmp/bflbwifid.log &
    ;;
  stop)
    killall bflbwifid 2>/dev/null || true
    rmmod mr_sdio 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
